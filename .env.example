# RepairTag Deployment & Network Configuration

# Botchain Testnet RPC
BOTCHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOTCHAIN_CHAIN_ID=968
NEXT_PUBLIC_BOTCHAIN_EXPLORER_URL=https://scan.bohr.life

# Private key of the deployer technician (WITHOUT 0x prefix or WITH 0x prefix)
# Required for running `npm run deploy:botchain`
PRIVATE_KEY=

# Deployed RepairTag contract address on Botchain Testnet
# Fill this in after deploying the contract
NEXT_PUBLIC_CONTRACT_ADDRESS=

